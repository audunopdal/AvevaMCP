<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="4.0">
  <Import Condition="Exists('$(VIEW_ROOT)')" Project="$(VIEW_ROOT)\Build\AVEVA_msbuild.props" />
  <PropertyGroup>
    <ReferencePath>$(UNIFIED_ENGINEERING_REFERENCE_PATH)</ReferencePath>
  </PropertyGroup>
  <PropertyGroup Condition="Exists('$(AVEVA_DESIGN_EXE)')">
    <ReferencePath>$(AVEVA_DESIGN_EXE)</ReferencePath>
  </PropertyGroup>
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <OutputType>Library</OutputType>
    <RootNamespace>AvevaMcp.CafAddin</RootNamespace>
    <AssemblyName>AvevaMcp.CafAddin</AssemblyName>
    <TargetFrameworkVersion>v4.8.1</TargetFrameworkVersion>
    <LangVersion>7.3</LangVersion>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <Reference Include="Aveva.ApplicationFramework" />
    <Reference Include="Aveva.Core.Database" />
    <Reference Include="Aveva.Core.Geometry" />
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.IO.Pipes" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="Newtonsoft.Json" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="McpBridgeAddin.cs" />
    <Compile Include="PipeBridgeHost.cs" />
    <Compile Include="CafOperations.cs" />
  </ItemGroup>
  <Import Project="$(MSBuildBinPath)\Microsoft.CSharp.targets" />
  <PropertyGroup>
    <PostBuildEvent Condition="'$(CAF_ADDINS_PATH)' != ''">copy /Y "$(TargetPath)" "$(CAF_ADDINS_PATH)$(TargetFileName)"</PostBuildEvent>
  </PropertyGroup>
</Project>
