{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "powershell.exe",
            "type": "process",
            "args": [
                "-NoProfile",
                "-File",
                "${workspaceFolder}\\build-debug.ps1"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build-release",
            "command": "powershell.exe",
            "type": "process",
            "args": [
                "-NoProfile",
                "-File",
                "${workspaceFolder}\\build-release.ps1"
            ],
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build-server",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/src/AvevaMcp.Server/AvevaMcp.Server.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/src/AvevaMcp.Server/AvevaMcp.Server.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/src/AvevaMcp.Server/AvevaMcp.Server.csproj"
            ],
            "problemMatcher": "$msCompile"
        }
    ]
}